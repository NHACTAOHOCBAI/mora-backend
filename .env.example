# Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/mora_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password

# Browser origins allowed to call REST and WebSocket endpoints (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required security settings. JWT_SECRET must be 32 bytes or longer.
JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
JWT_EXPIRATION_MS=86400000

# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=replace-me
R2_SECRET_KEY=replace-me
R2_BUCKET=mora-documents
R2_PUBLIC_URL=https://files.example.test

# AI Service (credentials are configured only in mora-ai/.env)
AI_SERVICE_URL=http://localhost:8000
AI_REINDEX_ON_STARTUP=false

# Disabled by default. When true, all four values below are required.
MORA_ADMIN_SEED_ENABLED=false
MORA_ADMIN_PASSWORD=
MORA_ADMIN_EMAIL=
MORA_ADMIN_FULL_NAME=
